---
/**
 * Ficha de integrante en el directorio.
 *
 * `role` y `dependency` solo se pintan cuando aportan información. Antes cada
 * ficha repetía "FCA" y "MIEMBRO FUNDADOR" bajo un encabezado que ya decía
 * "Facultad de Contaduría y Administración": 42 tokens redundantes que el ojo
 * tenía que filtrar para llegar a 22 nombres.
 */

interface Props {
  name: string;
  role: string;
  /** Cargo que comparten casi todos y que, por tanto, no distingue a nadie. */
  defaultRole?: string;
  grado?: string;
  slug?: string;
}

const {
  name,
  role,
  defaultRole = 'Miembro fundador',
  grado,
  slug,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const initials = name
  .split(' ')
  .filter((_, index, all) => index === 0 || index === all.length - 1)
  .map((word) => word.charAt(0).toUpperCase())
  .join('');

const displayName = grado ? `${grado} ${name}` : name;
const href = slug ? `${base}integrantes/${slug}/` : null;
const meta = role === defaultRole ? null : role;
---

<article class="member-card">
  <div class="member-card__avatar" aria-hidden="true">{initials}</div>
  <div class="member-card__info">
    <h3 class="member-card__name">
      {href ? <a href={href}>{displayName}</a> : displayName}
    </h3>
    {meta && <p class="member-card__meta">{meta}</p>}
  </div>
</article>
