---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import {
  buildGraph,
  breadcrumbNode,
  organizationNode,
  webPageNode,
  websiteNode,
} from '../lib/schema';
import '../styles/global.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  /** Título completo de <title>. Si se omite se usa la plantilla estándar. */
  seoTitle?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Omite <link rel="canonical">. Solo para la página 404. */
  noCanonical?: boolean;
  breadcrumbs?: Crumb[];
  /** Fecha ISO de última actualización del contenido. */
  dateModified?: string;
  /** Nodos JSON-LD adicionales propios de la página. */
  schemaNodes?: unknown[];
}

const {
  title,
  seoTitle,
  description = 'Red de Educación para el Desarrollo Regional y Sostenible — UAGro',
  ogImage = 'images/screen.png',
  noindex = false,
  noCanonical = false,
  breadcrumbs,
  dateModified,
  schemaNodes = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const cleanOgPath = ogImage.startsWith('/') ? ogImage.slice(1) : ogImage;
const absoluteOgImage = new URL(`${import.meta.env.BASE_URL}${cleanOgPath}`, Astro.site).href;

const formattedTitle = seoTitle ?? `${title} — REDRYS`;

const jsonLd = buildGraph([
  organizationNode(),
  Astro.url.pathname === '/' ? websiteNode() : null,
  noindex
    ? null
    : webPageNode({
        canonical: canonicalURL,
        title: formattedTitle,
        description,
        dateModified,
      }),
  breadcrumbs?.length ? breadcrumbNode(canonicalURL, breadcrumbs) : null,
  ...schemaNodes,
]);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Metaetiquetas básicas de SEO -->
    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}
    <meta name="theme-color" content="#0D2F36" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Iconos y compatibilidad móvil -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}images/logo-redrys-uagro.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}images/logo-redrys-uagro.png`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content={`${site.name} — ${site.fullName}`} />
    <meta property="og:site_name" content="REDRYS" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.fullName}`} />

    <!--
      Tipografías autoalojadas. Se precargan las dos familias que componen la
      primera pantalla para que el texto no cambie de métrica después de pintar:
      el layout shift medido antes procedía íntegramente del intercambio de
      webfonts servidas por `fonts.gstatic.com`.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/source-serif-4-latin-wght-normal.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/source-sans-3-latin-wght-normal.woff2`}
      crossorigin
    />

    <!-- Datos estructurados Schema.org (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <Header />
    <main id="main-content">
      {breadcrumbs?.length ? (
        <div class="container">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      ) : null}
      <slot />
    </main>
    <Footer />
  </body>
</html>
