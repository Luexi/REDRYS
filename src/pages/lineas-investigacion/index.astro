---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';

const base = import.meta.env.BASE_URL;

const lineas = (await getCollection('lineas')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const ultimaActualizacion = lineas
  .map((linea) => linea.data.actualizado.toISOString().slice(0, 10))
  .sort()
  .at(-1);
---

<BaseLayout
  title="Líneas de investigación"
  seoTitle="Líneas de investigación de REDRYS — UAGro, Guerrero"
  description="Las tres líneas de investigación e incidencia social de la REDRYS: dirección y liderazgo para el desarrollo sostenible, cultura tributaria y responsabilidad fiscal, y políticas públicas para el desarrollo regional."
  breadcrumbs={[{ label: 'Líneas de investigación', href: '/lineas-investigacion/' }]}
  dateModified={ultimaActualizacion}
>
  <section class="page-section container">
    <SectionTitle
      label="REDRYS"
      title="Líneas de investigación"
      subtitle="El Artículo 1 del reglamento de la REDRYS establece tres líneas de investigación e incidencia social. Cada una organiza proyectos, formación y difusión dentro de la red."
    />

    <div class="content-block">
      <p class="content-block__text">
        Las tres líneas comparten un mismo marco de trabajo. Todo proyecto debe
        integrar al menos un profesor-investigador y dos estudiantes de posgrado,
        debe contar con una evaluación de impacto social, y sus resultados deben
        divulgarse en acceso abierto citando la afiliación REDRYS/UAGro. Estas
        condiciones están fijadas en los
        <a href={`${base}documentos/reglamento/`}>Artículos 12 y 13 del reglamento</a>.
      </p>
    </div>

    <ul class="linea-index">
      {lineas.map((linea) => (
        <li class="linea-index__item">
          <article class="linea-index__card">
            <p class="linea-index__number">{String(linea.data.orden).padStart(2, '0')}</p>
            <h2 class="linea-index__title">
              <a href={`${base}lineas-investigacion/${linea.id}/`}>{linea.data.titulo}</a>
            </h2>
            <p class="linea-index__summary">{linea.data.resumen}</p>
            <span class="linea-index__cta" aria-hidden="true">Ver la línea →</span>
          </article>
        </li>
      ))}
    </ul>

    <div class="content-block">
      <h2 class="content-block__title">Cómo participar en una línea</h2>
      <p class="content-block__text">
        La incorporación a la red y a sus líneas se realiza conforme al Artículo 5
        del reglamento. Los requisitos y el procedimiento están descritos en la
        página <a href={`${base}colaborar/`}>Colaborar con la REDRYS</a>.
      </p>
    </div>
  </section>
</BaseLayout>
