---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { articulosHref } from '../lib/reglamento';

const base = import.meta.env.BASE_URL;
const articulo = await articulosHref([13], base);
---

<BaseLayout
  title="Repositorio"
  description="Repositorio académico de la REDRYS — publicaciones, ponencias y material de investigación en acceso abierto."
  noindex={true}
  breadcrumbs={[{ label: 'Repositorio', href: '/repositorio/' }]}
>
  <section class="page-section container">
    <SectionTitle
      title="Repositorio académico"
      subtitle="Espacio destinado a la difusión de la producción académica generada por los integrantes de la red."
    />

    <div class="page-placeholder">
      <h2 class="page-placeholder__title">Sección en preparación</h2>
      <p class="page-placeholder__text">
        La recopilación del catálogo de publicaciones, ponencias y materiales de la
        red está en curso. Las fichas se publicarán con sus metadatos completos
        —autores, año, línea de investigación, revista o evento, DOI y forma de
        citar— conforme se verifiquen y se confirmen los derechos de publicación.
      </p>
      <p class="page-placeholder__note">
        Mientras no tenga contenido, esta página está marcada como no indexable y no
        forma parte del sitemap del sitio.
      </p>
    </div>

    <div class="content-block content-block--group">
      <h2 class="content-block__title">Política de acceso abierto</h2>
      <p class="content-block__text">
        El <a href={articulo[13]}>Artículo 13 del reglamento de la REDRYS</a>
        establece que los resultados de investigación deberán divulgarse en acceso
        abierto, citando la afiliación a la REDRYS/UAGro. Este repositorio existe
        para dar cumplimiento a esa disposición.
      </p>
    </div>

    <div class="content-block content-block--group">
      <h2 class="content-block__title">Contenido previsto</h2>
      <ul class="feature-list">
        <li class="feature-list__item">
          <span class="feature-list__term">Publicaciones</span>
          <span class="feature-list__text">
            Artículos, capítulos de libro y memorias con afiliación REDRYS/UAGro.
          </span>
        </li>
        <li class="feature-list__item">
          <span class="feature-list__term">Ponencias</span>
          <span class="feature-list__text">
            Participaciones en congresos, foros y encuentros académicos.
          </span>
        </li>
        <li class="feature-list__item">
          <span class="feature-list__term">Material didáctico</span>
          <span class="feature-list__text">
            Recursos de formación producidos por la comisión de formación.
          </span>
        </li>
      </ul>
      <p class="content-block__text">
        Entre tanto, las
        <a href={`${base}lineas-investigacion/`}>líneas de investigación</a> describen
        los campos de trabajo de la red, y los
        <a href={`${base}documentos/`}>documentos fundacionales</a> reúnen la
        normativa vigente.
      </p>
    </div>
  </section>
</BaseLayout>
