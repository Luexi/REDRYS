---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Galería"
  description="Galería fotográfica de la REDRYS — Red de Educación para el Desarrollo Regional y Sostenible."
  noindex={true}
  breadcrumbs={[{ label: 'Galería', href: '/galeria/' }]}
>
  <section class="page-section container">
    <SectionTitle
      title="Galería"
      subtitle="Registro fotográfico de las actividades de la red."
    />

    <div class="page-placeholder">
      <h2 class="page-placeholder__title">Sección en preparación</h2>
      <p class="page-placeholder__text">
        Esta sección albergará registros fotográficos de eventos, reuniones y
        actividades de la REDRYS. El contenido se incorporará conforme se desarrollen
        las actividades de la red y se cuente con las autorizaciones de uso de imagen
        correspondientes.
      </p>
      <p class="page-placeholder__note">
        Mientras no tenga contenido, esta página está marcada como no indexable y no
        forma parte del sitemap del sitio.
      </p>
    </div>

    <div class="content-block content-block--group">
      <h2 class="content-block__title">Mientras tanto</h2>
      <ul class="related-list">
        <li class="related-list__item">
          <a class="related-list__link" href={`${base}la-red/`}>La Red</a>
          <span class="related-list__summary">Naturaleza, estructura y comisiones de trabajo.</span>
        </li>
        <li class="related-list__item">
          <a class="related-list__link" href={`${base}integrantes/`}>Integrantes</a>
          <span class="related-list__summary">Directorio de los miembros fundadores.</span>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
